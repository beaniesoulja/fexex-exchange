generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum OrderType {
  BUY_CRYPTO
  SELL_CRYPTO
  SELL_GIFTCARD
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
  REJECTED
}

enum SwapStatus {
  COMPLETED
}

enum PayoutStatus {
  INITIATED
  COMPLETED
  FAILED
}

enum UserActivityType {
  LOGIN
  TRADE_SUBMITTED
  CRYPTO_SWAPPED
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  username            String?  @unique
  legalName           String?
  dateOfBirth         DateTime?
  avatarData          String?
  phoneCountryCode    String?
  phoneNumber         String?
  passwordHash        String
  cryptoWalletAddress String?
  bankName            String?
  bankAccountNumber   String?
  role                Role     @default(USER)
  kycVerified         Boolean  @default(false)
  marketplaceBuyerApproved Boolean @default(false)
  bio                 String?  @db.VarChar(180)
  nameDisplay          String  @default("USERNAME")
  preferredCurrency    String  @default("NGN")
  timezone             String  @default("Africa/Lagos")
  createdAt           DateTime @default(now())
  lastLoginAt         DateTime?
  lastActiveAt        DateTime?

  wallet     Wallet?
  orders     Order[]
  swaps      Swap[]
  payouts    Payout[]
  activities UserActivity[]
  tradeMessages TradeMessage[]
  loginSessions LoginSession[]
  profileAudits ProfileAudit[]
  passwordResetTokens PasswordResetToken[]

  @@unique([phoneCountryCode, phoneNumber])
}

model ProfileAudit {
  id        String   @id @default(cuid())
  userId    String
  type      String
  details   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([createdAt])
}

model LoginSession {
  id        String   @id @default(cuid())
  userId    String
  browser   String
  os        String
  ipAddress String?
  location  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, active, lastSeenAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Wallet {
  id            String @id @default(cuid())
  userId        String @unique
  user          User   @relation(fields: [userId], references: [id])
  fiatBalance   Float  @default(0.0)
  cryptoBalance Float  @default(0.0)
}

model Order {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type   OrderType
  status OrderStatus @default(PENDING)

  amount     Float
  rate       Float
  totalValue Float

  giftCardBrand   String?
  giftCardCountry String?
  giftCardImage   String?
  giftCardCode    String?
  cryptoAsset     String?
  payoutBankName  String?
  payoutAccountName String?
  payoutBankAccountNumber String?

  payout Payout?
  tradeMessages TradeMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TradeMessage {
  id        String   @id @default(cuid())
  orderId   String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Payout {
  id                String       @id @default(cuid())
  orderId           String       @unique
  order             Order        @relation(fields: [orderId], references: [id])
  userId            String
  user              User         @relation(fields: [userId], references: [id])
  walletAddress     String
  nairaAmount       Float
  cryptoAmount      Float
  exchangeRate      Float
  status            PayoutStatus @default(INITIATED)
  providerReference String?
  providerResponse  String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([userId, createdAt])
}

model Swap {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  asset        String     @default("USDT")
  cryptoAmount Float
  nairaAmount  Float
  rate         Float
  status       SwapStatus @default(COMPLETED)
  createdAt    DateTime   @default(now())

  @@index([userId, createdAt])
}

model PricingSettings {
  id             String   @id @default("default")
  usdToNairaRate Float    @default(1600)
  updatedAt      DateTime @updatedAt
}

model GiftCardRate {
  id             String   @id @default(cuid())
  brand          String   @unique
  payoutPercent  Float    @default(0)
  nairaPayoutPerThousand Float @default(0)
  nairaPayoutPerUsd Float @default(0)
  isActive       Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

model CryptoRate {
  id                   String   @id @default(cuid())
  asset                String   @unique
  nairaPayoutPerUsd    Float    @default(0)
  isActive             Boolean  @default(false)
  updatedAt            DateTime @updatedAt
}

model UserActivity {
  id        String           @id @default(cuid())
  userId    String
  orderId   String?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      UserActivityType
  details   String?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([orderId])
}
